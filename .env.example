# Copie para `.env.local` e preencha (Vite expõe apenas variáveis com prefixo VITE_).
# Este app é Vite + React — não use NEXT_PUBLIC_* aqui.

# --- API própria (stockpyrou-api / Railway → Postgres EasyPanel stock-pyrou) ---
# true = front chama a API Node (padrão). false = Supabase client + Edge.
VITE_USE_OWN_API=true

# Base da API (inclui /api, sem barra no final)
# Local (proxy Vite): /api
# Railway produção:
VITE_API_URL=https://stockpyrou-api-production.up.railway.app/api

# --- Supabase (só se VITE_USE_OWN_API=false, ou auth/edge legado ZIG/Admin/Custos) ---
VITE_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co

# Opcional: chave publishable do dashboard (createClient)
# VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_...

# Obrigatório para fetch às Edge Functions (ZIG/Admin) enquanto não migrados:
# JWT anon "anon" "public" (eyJ...)
VITE_SUPABASE_ANON_KEY=
